# ---- Frontend (React) ----------------------------------------------------
FRONTEND_PORT=3000
# Use 0.0.0.0 to reach the UI from other machines.
FRONTEND_BIND=127.0.0.1

# ---- Controller -------------------------------------------------------------
CONTROLLER_PORT=8090
CONTROLLER_BIND=127.0.0.1

# ---- Backends (vLLM-Omni) ---------------------------------------------------
VLLM_OMNI_TAG=v0.30.0
# Where model weights live. Either a Docker named volume (default) or an
# ABSOLUTE host path, e.g. /data/hf-models. Mounted read-only into backends.
TTSBENCH_MODELS_SOURCE=ttsbench-models
# GPUs for backends: all | none | comma-separated device ids (e.g. 0,1)
BACKEND_GPUS=all
# Interface the backend API ports (config/models.yaml host_port) bind to.
BACKEND_BIND=127.0.0.1
BACKEND_SHM=8g
# Only one backend at a time (recommended on a single GPU).
EXCLUSIVE_BACKENDS=true
# Send one discarded request after a backend loads so stored clips are not cold starts.
BACKEND_WARMUP=true

# Needed only for gated models when downloading.
HF_TOKEN=

# ---- Development ------------------------------------------------------------
# Use the GPU-free mock backend instead of vLLM-Omni (pair with BACKEND_GPUS=none):
# BACKEND_IMAGE=ttsbench/mock-tts:latest
